.env

# LLM / embedding cache (raw API responses; reproduce with fetch + run)
.cache/

# Corpus text fetched from AIFdb.
# QT30's redistribution terms are not stated explicitly, so it is not included in this repository.
# Fetch it yourself with `make aif-fetch` (see "Data handling" in the README).
data/aifdb/

# Raw experiment output. Generated graphs and evidence contain corpus text, so they are not published.
# Aggregated values (without corpus text) live in data/metrics/.
out/

# Raw experiment output placed outside out/ (e.g. aif-test-*) is not published for the same reason.
aif-test-*/

# Figure 2 of the paper (an example generated graph) contains QT30 utterances verbatim, so it is not published.
# scripts/make_paper_figs.py generates it locally from the raw output in out/.
docs/figures/*

# Build artifacts. Manuscripts are also excluded here.
*.pptx
*.pdf
*.docx
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.sh