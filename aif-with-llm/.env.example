# ---- 必須 ----
OPENAI_API_KEY=sk-...

# 抽出に使うモデル。論文の数値は gpt-5.6-luna で取得した。
MODEL_MINING=gpt-5.6-luna

# ---- 再現性に関わる設定（既定のままで論文の数値が出る）----
# LLM 応答と埋め込みをここにキャッシュする。
# 同じ入力・同じプロンプト版なら 2 回目以降は課金されず、同じ数値が出る。
LLM_CACHE_DIR=.cache/llm
PROMPTS_DIR=prompts

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=0

# ---- OpenAI API へのレート制御 ----
LLM_RATE_LIMIT_RPS=4
LLM_BURST=4
LLM_MAX_RETRIES=4
