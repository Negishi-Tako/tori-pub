# ---- Required ----
OPENAI_API_KEY=sk-...

# Model used for extraction. The paper's numbers were obtained with gpt-5.6-luna.
MODEL_MINING=gpt-5.6-luna

# ---- Reproducibility settings (the defaults reproduce the paper's numbers) ----
# LLM responses and embeddings are cached here.
# With the same input and prompt version, later runs are not billed and yield the same numbers.
LLM_CACHE_DIR=.cache/llm
PROMPTS_DIR=prompts

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=0

# ---- Rate control for the OpenAI API ----
LLM_RATE_LIMIT_RPS=4
LLM_BURST=4
LLM_MAX_RETRIES=4
